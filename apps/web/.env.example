# Copy to apps/web/.env.local for local use. NEXT_PUBLIC fields reach the browser;
# managed identity/session fields below are SERVER-ONLY. Never put provider keys here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

APP_MODE=prototype
# APP_BASE_URL=https://your-web-origin.example
# BACKEND_API_BASE_URL=https://your-api-origin.example
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=  (independent random 32-byte hex secret)
# AUTH0_AUDIENCE=urn:airshedos:pilot-api
# SESSION_DATABASE_URL=postgresql://... (verified TLS, restricted session role)
# SESSION_ENCRYPTION_KEY=  (different random 32-byte hex key)
# SESSION_ENCRYPTION_PREVIOUS_KEY=  (optional during key rotation)
# AUTH_ALLOW_LOCAL_HTTP=1  (localhost + development only; forbidden in production)

# Phase 6: private pilot locations must not reach a third-party map without approval.
# Build-time flag; an existing public Maps key alone cannot enable pilot maps.
NEXT_PUBLIC_PILOT_MAPS_APPROVED=0

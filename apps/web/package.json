{
  "name": "airshedos-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:identity": "tsx --test tests/identity.test.ts",
    "test:resident": "tsx tests/resident/run.mts",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/lib/api-schema.d.ts",
    "test:authority": "tsx tests/resident/run.mts --authority",
    "test:pilot": "tsx tests/resident/run.mts --release --all",
    "test:plume": "tsx --test tests/plume.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.33.0",
    "jose": "6.2.17",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/google.maps": "3.66.3",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}

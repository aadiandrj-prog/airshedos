# REVIEW TEMPLATE ONLY. Values are empty intentionally; no live service is configured.
# Split secrets by service/role; do not provide this entire file to the browser or every process.
# API/worker/Next runtime: separate processes. Migrations and restore are offline operator tasks.
APP_MODE=pilot
APP_BASE_URL=https://pilot.example.invalid
BACKEND_API_BASE_URL=https://api.example.invalid
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=urn:airshedos:pilot-api
AUTH0_ALLOWED_CLIENT_ID=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
SESSION_ENCRYPTION_KEY=
SESSION_DATABASE_URL=
DATABASE_URL=
SEVA_WORKER_DATABASE_URL=
SEVA_CLEANUP_DATABASE_URL=
SEVA_RECOVERY_DATABASE_URL=
SEVA_OPERATOR_DATABASE_ROLE=
SEVA_MIGRATION_DATABASE_URL=
# Generate/store a fresh UUID outside the backed-up database. Bootstrap empty DB or
# complete quarantine/replay/release first. Never reuse an old epoch for a restored target.
SEVA_RECOVERY_EPOCH=
PILOT_TRIAGE_UNIT_ID=
PILOT_MEDIA_REQUIRED=1
PRIVATE_MEDIA_APPROVED=0
MEDIA_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RETAINED_PROVIDER_CONTENT_APPROVED=0
GOOGLE_CLOUD_PROJECT=
EARTH_ENGINE_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_MAPS_PLATFORM_API_KEY=
NASA_FIRMS_MAP_KEY=
# Optional fixed-area public overview. Shared PostgreSQL admission, no arbitrary coordinates.
PUBLIC_OVERVIEW_ENABLED=0
PUBLIC_OVERVIEW_HTTP_PER_DAY=100
PUBLIC_OVERVIEW_REQUESTS_PER_HOUR=120
SEVA_REPORTS_PER_DAY=10
SEVA_UPLOADS_PER_HOUR=10
SEVA_REFRESHES_PER_HOUR=2
SEVA_PROVIDER_CALLS_PER_DAY=100
SEVA_WORKER_LEASE_SECONDS=120
# Owner-confirmed host backup ceiling, NOT an automatic host backup policy setting.
BACKUP_RETENTION_DAYS=7
# Only these public variables may reach a frontend build. Approval defaults OFF.
NEXT_PUBLIC_PILOT_MAPS_APPROVED=0
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_TELEMETRY_DISABLED=1

# Copy to ROOT .env for backend/Compose. Never copy provider keys to apps/web.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend accepts these browser origins (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 1B: backend-only credentials. Missing keys produce NOT_CONFIGURED.
GOOGLE_MAPS_PLATFORM_API_KEY=
NASA_FIRMS_MAP_KEY=
ENVIRONMENT_HTTP_TIMEOUT_SECONDS=8
ENVIRONMENT_CACHE_TTL_SECONDS=600
FIRMS_CACHE_TTL_SECONDS=900
FIRMS_SEARCH_RADIUS_KM=25
FIRMS_DATASET=VIIRS_NOAA20_NRT

# Backend ADC project shared by Vertex Gemini and Earth Engine.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Phase 1C: explicit Earth Engine project, falls back to GOOGLE_CLOUD_PROJECT.
# Authenticate via backend ADC; provider API keys cannot authenticate Earth Engine.
EARTH_ENGINE_PROJECT=
SATELLITE_LOOKBACK_HOURS=72
SATELLITE_RADIUS_KM=10
SATELLITE_CACHE_TTL_SECONDS=3600
SATELLITE_TIMEOUT_SECONDS=25

# Phase 2B deterministic checklist policy; see docs/CORROBORATION_RULES.md.
CORROBORATION_REPORT_TTL_SECONDS=1800
CORROBORATION_REPORT_MAX_ENTRIES=256
CORROBORATION_AQ_MAX_AGE_HOURS=2
CORROBORATION_WEATHER_MAX_AGE_HOURS=1
CORROBORATION_FIRES_MAX_AGE_HOURS=24
CORROBORATION_FIRES_STRONG_AGE_HOURS=6
CORROBORATION_SATELLITE_MAX_AGE_HOURS=24
CORROBORATION_FIRE_VERY_NEAR_KM=5
CORROBORATION_FIRE_NEAR_KM=15
CORROBORATION_FIRE_REGIONAL_KM=25
CORROBORATION_WIND_TOLERANCE_DEGREES=45
CORROBORATION_WIND_MIN_SPEED_MPS=1
CORROBORATION_WIND_FIRE_MAX_TIME_GAP_HOURS=1
CORROBORATION_FUTURE_TOLERANCE_SECONDS=300

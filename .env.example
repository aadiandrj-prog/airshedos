# Copy to apps/web/.env.local for npm development. Compose reads this from root .env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend accepts these browser origins (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future integrations: UNUSED in Phase 1A; no credentials required.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
GOOGLE_MAPS_API_KEY=
BIGQUERY_DATASET=
